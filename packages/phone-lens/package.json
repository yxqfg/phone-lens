{
  "name": "phone-lens",
  "description": "Phone camera → dsh session: pairing, MJPEG viewfinder, upload-to-attachment pipeline",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dev": {
      "default": "./lib/dev.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "dev:standalone": "node lib/dev.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <4.0.1 || >=4.0.1-0 <5.0.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1 <0.1.1 || >=0.1.1-rc.2 <0.2.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0 <3.18.1 || >=3.18.1-0 <4.0.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "tsdown": "^0.9.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yxqfg/phone-lens"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "rolldown",
      "esbuild"
    ]
  }
}
