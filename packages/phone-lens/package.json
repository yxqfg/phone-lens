{
  "name": "phone-lens",
  "description": "Turn your phone into a full-featured camera for dsh sessions (requires the companion app; open source — install the plugin and scan the QR code it shows to get the app): 1. Live viewfinder over LAN or USB, injectable into the chat or savable to a folder. 2. Callable tools let the dsh model take photos, zoom, and switch lenses on demand mid-conversation, so in fully automated workflows the model can actively \"see\" the physical world. 3. Full zoom/flash, crop, and annotation. 4. Rich settings.",
  "version": "1.1.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dev": {
      "default": "./lib/dev.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "dev:standalone": "node lib/dev.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <4.0.1 || >=4.0.1-0 <5.0.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1 <0.1.1 || >=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.1 <0.1.3-0 || >=0.1.3-alpha.1 <0.1.5-0 || >=0.1.5-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0 <3.18.1 || >=3.18.1-0 <4.0.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "tsdown": "^0.9.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxqfg/phone-lens.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "rolldown",
      "esbuild"
    ]
  }
}
